generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ScooterModel {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  model             String
  panorama          String?
  glbModelUrl       String?  // Phase 2: Moved from Design to Model (20-30MB baked texture + UV)
  glbModelCompressed String?
  glbModelMobile    String?
  // SEO fields
  seoTitle          String?  // SEO заголовок модели
  seoDescription    String?  // SEO описание модели
  active            Boolean  @default(true)
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  designs           Design[]

  @@index([slug])
  @@index([active])
}

model Design {
  id                 String                 @id @default(cuid())
  title              String
  slug               String                 @unique
  scooterModelId     String
  description        String?
  price              Int                    @default(0)
  editionTotal       Int                    @default(5)
  editionAvailable   Int                    @default(5)
  coverImage         String?
  galleryImages      String[]               @default([])
  panorama           String?
  videoPreview       String?
  videoFull          String?
  videoTutorial      String?
  // Phase 2: glbModelUrl, glbModelCompressed, glbModelMobile moved to ScooterModel
  textureUrl         String?
  // WebP optimization fields
  textureWebp        String?  // WebP текстура для 3D (512x512, <1MB)
  bgWebp             String?  // WebP фон 3D сцены (1920x1080, <1MB)
  // Design info for SEO
  filmType           String?  // Тип пленки для SEO (например: "Carbon Fiber", "Matte Black")
  seoTitle           String?  // SEO заголовок дизайна
  blueprintSvg       String?
  blueprintPdf       String?
  blueprintHotspots  Json?
  thumbnail          String?
  socialPreview      String?
  status             DesignStatus           @default(CREATIVE)
  published          Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deals              Deal[]
  scooterModel       ScooterModel           @relation(fields: [scooterModelId], references: [id], onDelete: Cascade)
  modelProperties    DesignModelProperties?
  statusHistory      DesignStatusHistory[]
  materials          Material[]             // Phase 1: New Material model (optional, for future migration)
  textures           DesignTexture[]         // Legacy
  orders             Order[]
}

model DesignStatusHistory {
  id       String       @id @default(cuid())
  designId String
  status   DesignStatus
  note     String?
  at       DateTime     @default(now())
  design   Design       @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
}

model Deal {
  id         String   @id @default(cuid())
  designId   String
  buyerName  String?
  buyerEmail String?
  status     String   @default("open")
  feedback   String?
  rating     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  design     Design   @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
  @@index([status])
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  username         String          @unique
  passwordHash     String
  twoFactorEnabled Boolean         @default(false)
  twoFactorSecret  String?
  emailVerified    Boolean         @default(false)
  isActive         Boolean         @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  twoFactorCodes   TwoFactorCode[]

  @@index([email])
  @@index([username])
}

model TwoFactorCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
}

model DesignTexture {
  id         String   @id @default(cuid())
  designId   String
  url        String
  type       String
  format     String
  resolution String?
  layer      Int      @default(0)
  createdAt  DateTime @default(now())
  design     Design   @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, type, layer], name: "designId_type_layer")
  @@index([designId])
  @@index([type])
}

model DesignModelProperties {
  id             String   @id @default(cuid())
  designId       String   @unique
  cameraPosition Json?
  cameraTarget   Json?
  lighting       Json?
  materials      Json?
  environmentMap String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  design         Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
}

model NewsletterSubscriber {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  subscribed        Boolean  @default(true)
  verified          Boolean  @default(false)
  verificationToken String?  @unique
  preferences       String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([email])
  @@index([subscribed])
}

model PromoCode {
  id            String   @id @default(cuid())
  code          String   @unique
  description   String?
  discountType  String
  discountValue Int
  minPurchase   Int?
  maxDiscount   Int?
  usageLimit    Int?
  usedCount     Int      @default(0)
  validFrom     DateTime
  validUntil    DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]

  @@index([code])
  @@index([active])
  @@index([validUntil])
}

model Order {
  id                 String     @id @default(cuid())
  orderId            String     @unique
  designId           String
  buyerName          String
  buyerEmail         String?
  buyerPhone         String
  address            String
  paymentMethod      String
  totalPrice         Int
  discountAmount     Int        @default(0)
  promoCodeId        String?
  status             String     @default("pending")
  paymentUrl         String?
  paymentId          String?
  paymentConfirmedAt DateTime?
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  design             Design     @relation(fields: [designId], references: [id], onDelete: Cascade)
  promoCode          PromoCode? @relation(fields: [promoCodeId], references: [id])

  @@index([designId])
  @@index([status])
  @@index([orderId])
  @@index([paymentMethod])
  @@index([promoCodeId])
}

model Material {
  id        String         @id @default(cuid())
  designId  String
  format    MaterialFormat
  url       String
  metadata  Json? // Role, order, resolution, etc.
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  design    Design         @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
  @@index([format])
  @@index([designId, format])
}

enum MaterialFormat {
  TEXTURE // UV texture for 3D model
  PANORAMA // 360 panorama for background
  VIDEO // Video preview/full/tutorial
  PHOTO // Gallery images, cover image
}

enum DesignStatus {
  CREATIVE
  MODELING_3D
  UV_TEMPLATE
  PRINTING
  FOR_SALE
  SOLD
  DELIVERY
  FEEDBACK
}
