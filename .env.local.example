# S3 Configuration для загрузки больших файлов (>10MB)
# Скопируйте этот файл в .env.local и заполните реальными значениями

# Вариант 1: Использование S3 переменных (рекомендуется)
S3_BUCKET=your-bucket-name
S3_KEY=your-access-key-id
S3_SECRET=your-secret-access-key
S3_REGION=us-east-1
S3_ENDPOINT=  # Опционально, для S3-совместимых хранилищ (Cloudflare R2, MinIO и т.д.)

# Вариант 2: Использование AWS переменных (альтернатива)
# AWS_S3_BUCKET_NAME=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=us-east-1

# Опционально: CloudFront CDN
# AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net
# NEXT_PUBLIC_IMAGE_CDN_DOMAIN=your-cloudfront-domain.cloudfront.net

# Database (если используется)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Другие переменные окружения
# NODE_ENV=development

# ============================================
# ИНСТРУКЦИЯ ПО ЗАПОЛНЕНИЮ:
# ============================================
# 
# 1. Создайте S3 bucket в AWS Console:
#    https://console.aws.amazon.com/s3/
# 
# 2. Создайте IAM пользователя с правами на S3:
#    https://console.aws.amazon.com/iam/
# 
# 3. Скопируйте Access Key ID и Secret Access Key
# 
# 4. Замените значения ниже на реальные:
#    S3_BUCKET=ваш-bucket-name
#    S3_KEY=ваш-access-key-id  
#    S3_SECRET=ваш-secret-access-key
#    S3_REGION=us-east-1
# 
# 5. Проверьте конфигурацию:
#    npm run check:s3
# 
# 6. Перезапустите dev сервер:
#    npm run dev
# 
# Подробная инструкция: docs/QUICK_S3_SETUP.md
